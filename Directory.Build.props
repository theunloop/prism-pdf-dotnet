<Project>

  <PropertyGroup>
    <!-- The Prism PDF core release this binding is built and tested against. Bump together with
         native/include/prismpdf.h and the note in native/VENDORED.md. -->
    <PrismPdfCoreTag>v0.4.0</PrismPdfCoreTag>

    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Prism PDF contributors</Authors>
    <Product>Prism PDF for .NET</Product>
    <Copyright>Copyright (c) 2026 UNLOOP SRL</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/theunloop/prism-pdf-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://github.com/theunloop/prism-pdf-dotnet</PackageProjectUrl>

    <!-- SourceLink. The .NET SDK has carried the GitHub provider since 8.0, so this needs no
         package reference — only the switches that make a debugger able to step into the binding
         from a consumer's application. CI adds ContinuousIntegrationBuild for a deterministic
         build; leaving it off locally keeps paths readable in a working tree. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
